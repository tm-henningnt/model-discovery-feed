{
  "name": "model-discovery-feed",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js example implementation of the Model Discovery Feed contract.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tm-henningnt/model-discovery-feed.git"
  },
  "bugs": {
    "url": "https://github.com/tm-henningnt/model-discovery-feed/issues"
  },
  "homepage": "https://github.com/tm-henningnt/model-discovery-feed#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:fixture": "node --import tsx scripts/validate-fixture.ts",
    "collect": "node --import tsx scripts/run-collectors.ts",
    "model-feed": "node --import tsx bin/model-feed.ts"
  },
  "bin": {
    "model-feed": "./bin/model-feed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "next": "^16.2.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "ajv": "^8.20.0",
    "prisma": "^6.11.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
