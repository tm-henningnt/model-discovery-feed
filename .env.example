# Vercel runtime uses the pooled Prisma Postgres URL for app/API traffic.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Optional: Prisma CLI/manual migrations use the direct Prisma Postgres URL.
# The scheduled GitHub Action does not need this while Prisma's GitHub
# integration owns schema application.
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Enable database-backed feed reads in production.
MODEL_FEED_USE_DATABASE="true"

# Optional: SHA-256 hex digest of the bearer token required for API reads.
MODEL_FEED_API_KEY_SHA256=""

# Optional collector credentials for the scheduled refresh workflow.
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
GITHUB_MODELS_TOKEN=""
